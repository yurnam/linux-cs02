// SPDX-License-Identifier: GPL-2.0-only
/*
 * Device tree for Samsung Galaxy Core 2 (SM-G350, cs02 rev02).
 *
 * Copyright (c) 2025 The Linux Kernel Authors
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "bcm21664.dtsi"

/ {
	model = "Samsung Galaxy Core 2 (SM-G350)";
	compatible = "samsung,cs02", "brcm,bcm21664";
	chassis-type = "handset";

	aliases {
		mmc0 = &sdio2;  /* Internal storage */
		mmc1 = &sdio1;  /* SD card */
		mmc2 = &sdio3;  /* WiFi SDIO */
		serial0 = &uartb;
		serial1 = &uartb2;
		serial2 = &uartb3;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x2e000000>; /* 736 MB */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		secure_mem: secure-mem@9d800000 {
			reg = <0x9d800000 0x100000>;
			no-map;
		};

		mobicore: mobicore@9d900000 {
			reg = <0x9d900000 0x300000>;
			no-map;
		};

		simplefb: framebuffer@ae980000 {
			reg = <0xae980000 (480 * 800 * 4)>;
			no-map;
		};
	};

	/* Hardware buttons */
	gpio-keys {
		compatible = "gpio-keys";

		key-volume-up {
			label = "Volume Up";
			gpios = <&gpio 9 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};

		key-home {
			label = "Home";
			gpios = <&gpio 10 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOMEPAGE>;
		};

		key-volume-down {
			label = "Volume Down";
			gpios = <&gpio 11 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};
	};

	/* Touchkey backlight LED */
	led-touchkey {
		compatible = "regulator-led";
		vled-supply = <&gpldo3_reg>;
		color = <LED_COLOR_ID_WHITE>;
		function = LED_FUNCTION_KBD_BACKLIGHT;
	};

	/* USB switch via GPIO I2C */
	i2c-musb {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 113 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 114 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;

		musb@14 {
			compatible = "richtek,rt8973a-muic";
			reg = <0x14>;
			interrupt-parent = <&gpio>;
			interrupts = <56 IRQ_TYPE_LEVEL_HIGH>;
		};
	};

	/*
	 * Fixed 3.3 V supply for the SDIO3 bus.  Advertising 3.3 V causes
	 * sdhci_set_power_noreg() (called via .set_power =
	 * sdhci_set_power_and_bus_voltage in the kona SDHCI driver) to write
	 * SDHCI_POWER_330 | SDHCI_POWER_ON into the bus-power register.
	 * The downstream kona driver always wrote that value; omitting the
	 * voltage-select bits leaves BCM21664 SDHCI3 in an undefined bus-power
	 * state where it will not drive CMD5, so the BCM4330 is never found.
	 *
	 * This regulator is always-on (no GPIO) so that the SDHCI bus is
	 * powered before WL_REG_ON is asserted.  The BCM4330 requires SDIO
	 * bus power to be present when it initializes its SDIO interface;
	 * if WL_REG_ON goes HIGH before the bus is powered the chip's SDIO
	 * I/O cells do not latch correctly and CMD5 times out.  WL_REG_ON
	 * is instead sequenced by wifi_pwrseq below.
	 */
	wl_reg: regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "WL_REG_ON";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/*
	 * mmc-pwrseq-simple for the BCM4330 WiFi chip.
	 *
	 * reset-gpios is ACTIVE_LOW so that the pwrseq driver drives GPIO 3
	 * LOW (chip held in reset) during probe, then releases it HIGH (chip
	 * powered and running) inside mmc_pwrseq_post_power_on() — which is
	 * called after the SDIO bus is powered — and waits 250 ms.  This
	 * matches the downstream __wifi_reset() timing and guarantees the
	 * correct bus-power → WL_REG_ON → delay → CMD5 sequence.
	 *
	 * The kona peripheral clock driver marks all SDIO clocks
	 * CLK_IGNORE_UNUSED, so clk_disable_unused() never gates the SDIO3
	 * clock even if the controller's probe is deferred until after
	 * late_initcall().
	 */
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <250>;
	};

	/* Simple framebuffer for display output (bootloader-initialized NT35510) */
	framebuffer@ae980000 {
		compatible = "simple-framebuffer";
		reg = <0xae980000 (480 * 800 * 4)>;
		width = <480>;
		height = <800>;
		stride = <(480 * 4)>;
		format = "a8r8g8b8";
		status = "okay";
	};
};

/* Bluetooth UART */
&uartb {
	status = "okay";
	clock-frequency = <48000000>;

	bluetooth {
		compatible = "brcm,bcm4330-bt";

		shutdown-gpios = <&gpio 28 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpio 32 GPIO_ACTIVE_HIGH>;
		host-wakeup-gpios = <&gpio 72 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio 71 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio>;
		interrupts = <72 IRQ_TYPE_EDGE_FALLING>;
	};
};

/* GPS UART */
&uartb2 {
	status = "okay";
	clock-frequency = <26000000>;
};

/* Console UART */
&uartb3 {
	status = "okay";
	clock-frequency = <26000000>;
};

&usbotg {
	vusb_d-supply = <&usbldo_reg>;
	vusb_a-supply = <&iosr1_reg>;
	status = "okay";
};

&usbphy {
	status = "okay";
};

/* Sensors: accelerometer, magnetometer, proximity */
&bsc3 {
	clock-frequency = <400000>;

	pinctrl-0 = <&bsc3_pins>;
	pinctrl-names = "default";

	status = "okay";

	accelerometer@10 {
		compatible = "bosch,bmc150_accel";
		reg = <0x10>;

		interrupt-parent = <&gpio>;
		interrupts = <92 IRQ_TYPE_EDGE_RISING>;

		vdd-supply = <&tcxldo_reg>;
		vddio-supply = <&iosr1_reg>;
	};

	magnetometer@12 {
		compatible = "bosch,bmc150_magn";
		reg = <0x12>;

		vdd-supply = <&tcxldo_reg>;
		vddio-supply = <&iosr1_reg>;
	};

	proximity@44 {
		compatible = "sharp,gp2ap002s00f";
		reg = <0x44>;

		interrupt-parent = <&gpio>;
		interrupts = <89 IRQ_TYPE_EDGE_FALLING>;

		vdd-supply = <&tcxldo_reg>; /* SENSOR_3.3V */
		vio-supply = <&vibldo_reg>; /* SENSOR_LED_3.3V */

		sharp,proximity-far-hysteresis = /bits/ 8 <0x2f>;
		sharp,proximity-close-hysteresis = /bits/ 8 <0x0c>;
	};
};

/* Touchscreen */
&bsc4 {
	clock-frequency = <400000>;

	pinctrl-0 = <&bsc4_pins>;
	pinctrl-names = "default";

	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt432";
		reg = <0x20>;

		interrupt-parent = <&gpio>;
		interrupts = <73 IRQ_TYPE_EDGE_FALLING>;

		vcca-supply = <&gpldo2_reg>;
		vdd-supply = <&iosr1_reg>;

		touchscreen-size-x = <480>;
		touchscreen-size-y = <800>;

		linux,keycodes = <KEY_MENU KEY_BACK>;
	};
};

/* PMU */
&pmu_bsc {
	clock-frequency = <3400000>;

	pinctrl-0 = <&pmbsc_pins>;
	pinctrl-names = "default";

	status = "okay";

	pmu: pmu@8 {
		compatible = "brcm,bcm59054";
		reg = <0x08>;
		interrupt-parent = <&gpio>;
		interrupts = <29 IRQ_TYPE_EDGE_FALLING>;

		regulators {
			rfldo_reg: rfldo {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			camldo1_reg: camldo1 {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			camldo2_reg: camldo2 {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			simldo1_reg: simldo1 {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
			};

			simldo2_reg: simldo2 {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
			};

			sdldo_reg: sdldo {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
			};

			sdxldo_reg: sdxldo {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
			};

			mmcldo1_reg: mmcldo1 {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
			};

			mmcldo2_reg: mmcldo2 {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
			};

			audldo_reg: audldo {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			usbldo_reg: usbldo {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
			};

			micldo_reg: micldo {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			vibldo_reg: vibldo {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
			};

			gpldo1_reg: gpldo1 {
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
			};

			gpldo2_reg: gpldo2 {
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
			};

			gpldo3_reg: gpldo3 {
				/* 3.3 V required for touchkey backlight LED */
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			tcxldo_reg: tcxldo {
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			lvldo1_reg: lvldo1 {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1800000>;
			};

			lvldo2_reg: lvldo2 {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1800000>;
			};

			vsr_reg: vsr {
				regulator-min-microvolt = <860000>;
				regulator-max-microvolt = <1800000>;
			};

			csr_reg: csr {
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1440000>;
				regulator-always-on;
			};

			mmsr_reg: mmsr {
				regulator-min-microvolt = <860000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			sdsr1_reg: sdsr1 {
				regulator-min-microvolt = <860000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			sdsr2_reg: sdsr2 {
				regulator-min-microvolt = <860000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			iosr1_reg: iosr1 {
				regulator-min-microvolt = <860000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			iosr2_reg: iosr2 {
				regulator-min-microvolt = <860000>;
				regulator-max-microvolt = <1800000>;
			};
		};
	};
};

/* SD card */
&sdio1 {
	max-frequency = <48000000>;

	cd-gpios = <&gpio 91 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	vmmc-supply = <&sdldo_reg>;
	vqmmc-supply = <&sdxldo_reg>;

	/* Disable UHS/DDR50 - kona SDHCI is unreliable in 1.8V modes */
	no-1-8-v;

	pinctrl-0 = <&sd_width4_pins>;
	pinctrl-names = "default";

	status = "okay";
};

/* Internal storage */
&sdio2 {
	max-frequency = <52000000>;

	keep-power-in-suspend;
	non-removable;
	bus-width = <8>;

	pinctrl-0 = <&mmc0_width8_pins>;
	pinctrl-names = "default";

	status = "okay";
};

/* WiFi */
&sdio3 {
	max-frequency = <48000000>;

	/* WL_REG_ON regulator; 3.3 V advertised so SDHCI uses SDHCI_POWER_330 */
	vmmc-supply = <&wl_reg>;
	/* GPIO 3 (WL_REG_ON) sequenced by wifi_pwrseq after bus power is on */
	mmc-pwrseq = <&wifi_pwrseq>;

	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-0 = <&mmc1_width4_pins>;
	pinctrl-names = "default";

	bus-width = <4>;
	keep-power-in-suspend;
	non-removable;
	no-sd;
	no-mmc;

	status = "okay";

	brcmf: wifi@1 {
		compatible = "brcm,bcm4330-fmac", "brcm,bcm4329-fmac";
		reg = <1>;

		/* brcmfmac looks for firmware at:
		 *   /lib/firmware/brcm/brcmfmac4330-sdio.samsung,cs02.bin
		 *   /lib/firmware/brcm/brcmfmac4330-sdio.samsung,cs02.txt
		 */
		brcm,board-type = "samsung,cs02";

		interrupt-parent = <&gpio>;
		interrupts = <74 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "host-wake";
	};
};
